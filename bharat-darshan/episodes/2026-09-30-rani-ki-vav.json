 "lines": [
  {
   "id": "l01",
   "tts": "सौ रुपये का नोट पलटिए... उस पर एक मंदिर छपा है, जो ज़मीन के ऊपर नहीं... अंदर बना है।",
   "caption": "₹100 का नोट पलटिए... उस पर एक मंदिर छपा है, जो ज़मीन के ऊपर नहीं... अंदर बना है।",
   "exag": 0.7
  },
  {
   "id": "l02",
   "tts": "और सदियों तक, ये पूरा का पूरा... मिट्टी में दबा रहा।",
   "exag": 0.65
  },
  {
   "id": "l03",
   "tts": "ये है, गुजरात के पाटन की... रानी की वाव।",
   "exag": 0.6
  },
  {
   "id": "l04",
   "tts": "ग्यारहवीं सदी में, रानी उदयमती ने, राजा भीमदेव प्रथम की याद में, ये बावड़ी बनवाई।",
   "caption": "11वीं सदी में, रानी उदयमती ने, राजा भीमदेव प्रथम की याद में, ये बावड़ी बनवाई।",
   "exag": 0.55
  },
  {
   "id": "l05",
   "tts": "सात मंज़िल नीचे उतरती सीढ़ियाँ... करीब सत्ताईस मीटर गहरी।",
   "caption": "7 मंज़िल नीचे उतरती सीढ़ियाँ... करीब 27 मीटर गहरी।",
   "exag": 0.6
  },
  {
   "id": "l06",
   "tts": "और दीवारों पर, पाँच सौ से ज़्यादा बड़ी मूर्तियाँ... ज़्यादातर, भगवान विष्णु के अवतारों की।",
   "caption": "और दीवारों पर, 500 से ज़्यादा बड़ी मूर्तियाँ... ज़्यादातर, भगवान विष्णु के अवतारों की।",
   "exag": 0.6
  },
  {
   "id": "l07",
   "tts": "इसे बनाया गया, एक उल्टे मंदिर की तरह... क्योंकि यहाँ, पानी ही पवित्र था।",
   "exag": 0.6
  },
  {
   "id": "l08",
   "tts": "पर असली रहस्य... इसके गायब होने में है।",
   "exag": 0.75
  },
  {
   "id": "l09",
   "tts": "पास बहती सरस्वती नदी की बाढ़ ने, इसे धीरे-धीरे, गाद से भर दिया।",
   "exag": 0.6
  },
  {
   "id": "l10",
   "tts": "सदियों बाद, बस कुआँ और कुछ खंभे ही, ऊपर दिखते थे।",
   "exag": 0.6
  },
  {
   "id": "l11",
   "tts": "फिर उन्नीस सौ अस्सी के दशक में, पुरातत्व सर्वेक्षण ने इसे फिर से सँवारा... और दो हज़ार चौदह में, ये बनी, यूनेस्को विश्व धरोहर।",
   "caption": "फिर 1980 के दशक में, पुरातत्व सर्वेक्षण (ASI) ने इसे फिर से सँवारा... और 2014 में, ये बनी, यूनेस्को विश्व धरोहर।",
   "exag": 0.55
  },
  {
   "id": "l12",
   "tts": "तो अगली बार, सौ का नोट हाथ में आए... याद रखिएगा, आप मिट्टी से लौटी, एक रानी की विरासत थामे हुए हैं।",
   "caption": "तो अगली बार, ₹100 का नोट हाथ में आए... याद रखिएगा, आप मिट्टी से लौटी, एक रानी की विरासत थामे हुए हैं।",
   "exag": 0.65
  },
  {
   "id": "l13",
   "tts": "पाटन और गुजरात की यात्रा का पूरा प्लान, सुज़ू ट्रैवल्स के साथ।",
   "exag": 0.55
  },
  {
   "id": "l14",
   "tts": "जुड़े रहिए भारत दर्शन के साथ... मिलते हैं अगले एपिसोड में।",
   "exag": 0.6
  }
