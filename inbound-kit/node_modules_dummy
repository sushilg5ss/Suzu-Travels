const { chromium } = require('playwright');
(async () => {
  const [url, out, w] = process.argv.slice(2);
  const b = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium' });
  const p = await b.newPage({ viewport: { width: +w, height: 900 } });
  const errs = []; p.on('pageerror', e => errs.push(e.message));
  await p.goto(url, { waitUntil: 'load', timeout: 90000 });
  try { await p.waitForSelector('.sx-toc', { timeout: 45000 }); await p.waitForLoadState('load'); } catch (e) {}
  await p.waitForTimeout(5000);
  const title = await p.title();
  if (/Checking your browser/i.test(title)) { console.log('CHALLENGE'); await b.close(); process.exit(3); }
  const info = await p.evaluate(() => {
    const t = document.getElementById('szt-trust'); const r = t ? t.getBoundingClientRect() : null;
    const over = [...document.querySelectorAll('#szt-trust *')].filter(e => e.getBoundingClientRect().right > innerWidth + 1).length;
    return { sw: document.documentElement.scrollWidth, cw: document.documentElement.clientWidth, iw: innerWidth, bodyW: document.body.getBoundingClientRect().width,
      h1: document.querySelectorAll('h1').length, has: !!t, n: (t ? document.querySelectorAll('#szt-trust').length : 0), w: r ? Math.round(r.width) : 0,
      ist: (document.getElementById('szt-ist') || {}).textContent, you: (document.getElementById('szt-you') || {}).textContent,
      rev: (document.getElementById('szt-rev-n') || {}).textContent, revHref: (document.getElementById('szt-rev') || {}).href,
      revShown: t ? getComputedStyle(document.getElementById('szt-rev')).display : '', wa: (document.getElementById('szt-wa') || {}).href, over,
      robots: (document.querySelector('meta[name=robots]') || {}).content };
  });
  if (info.has) { await p.$eval('#szt-trust', e => e.scrollIntoView({ block: 'start' })); await p.evaluate(() => scrollBy(0, -60)); await p.waitForTimeout(600); }
  await p.screenshot({ path: out });
  console.log(JSON.stringify({ ...info, errs }));
  await b.close();
})();
